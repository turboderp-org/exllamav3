# were committed between 2026-07-14 and now remain in git history)
qlora_runs.csv
qlora_runs.csv.*
# unsloth writes its compiled kernel cache into cwd
unsloth_compiled_cache/
# wandb local run artifacts (wandb is now opt-in; the local run_report is default)
wandb/

# written next to the sources by torch's hipify during ROCm builds
exllamav3/exllamav3_ext/**/*.hip
exllamav3/exllamav3_ext/**/*_hip.*
